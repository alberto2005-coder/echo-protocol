{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo Protocol",
  "version": "1.0.0",
  "identifier": "com.albertoortiz.echoprotocol",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Echo Protocol",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "3D first-person cyber combat FPS",
    "publisher": "Alberto Ortiz",
    "copyright": "Copyright (c) 2026 Alberto Ortiz",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
